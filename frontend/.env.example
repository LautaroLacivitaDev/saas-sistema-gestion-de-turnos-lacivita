# Variables del frontend. Copiá este archivo como .env.local y ajustá lo que haga falta.

# Dirección del backend (Spring Boot). Next le pasa las llamadas a /api/* y los Server Components
# leen desde ahí las páginas públicas.
BACKEND_URL=http://localhost:8080

# Dirección pública del sitio, para los links absolutos: Open Graph, datos estructurados y el código QR.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave del sitio de Cloudflare Turnstile (la pública; la secreta va en el backend). Vacía en desarrollo:
# no se muestra la verificación anti-bots y el backend también la tiene desactivada.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
