# https://editorconfig.org
# Coherente con Spotless (palantir-java-format) en el backend y con los defaults de Next.js en el frontend.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,sql}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
